# Twilio (backend only — never put these in React)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://YOUR-NGROK-URL.ngrok-free.app

# Local / security
TWILIO_VALIDATE_SIGNATURE=true
MSAR_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MSAR_DATA_DIR=./data

# Phase B SOS demo: browser geolocation needs HTTPS on real phones.
# Use an HTTPS tunnel (e.g. ngrok) for the Vite app and point VITE_FASTAPI_BASE_URL
# at the FastAPI public URL (or keep FastAPI local if the tunnel proxies both).
