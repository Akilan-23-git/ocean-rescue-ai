# API Configuration (Spring Boot — optional)
VITE_API_BASE_URL=http://localhost:8080/api

# FastAPI Emergency API (Phase A SMS + Phase B SOS)
# Expected format: Base URL must include the `/api` prefix (FastAPI routes are mounted under /api)
# For real-device SOS GPS, serve the frontend over HTTPS — browser geolocation requires a secure context.
# Local development:
VITE_FASTAPI_BASE_URL=http://localhost:8000/api
# Production / Ngrok tunnel:
# VITE_FASTAPI_BASE_URL=https://purebred-filter-undecided.ngrok-free.dev/api
